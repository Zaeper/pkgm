{
  "name": "@zaeper/pkgm",
  "version": "2.0.1",
  "description": "Package Management",
  "keywords": [
    "zaeper",
    "pkgm",
    "package management",
    "cli",
    "multi-project management",
    "monorepo",
    "multi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zaeper/pkgm.git"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "index.js",
  "scripts": {
    "run": "node ./dist/index.js",
    "build": "tsc",
    "test": "npm run build && jest",
