    "docs": "typedoc --entryPointStrategy Expand src --exclude src/test/**/* --excludeExternals"
  },
  "author": "Zaeper",
  "license": "MIT",
  "dependencies": {
    "@inquirer/core": "^11.1.5",
    "@inquirer/prompts": "^8.3.0",
    "@ptkdev/logger": "^1.8.0",
    "@types/figlet": "^1.7.0",
    "arg": "^5.0.2",
    "cli-table3": "^0.6.5",
    "figlet": "^1.10.0",
    "glob": "^11.0.0",
    "ora": "^5.4.1",
    "pkginfo": "^0.4.1",
    "rimraf": "^6.0.1",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@types/args": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.1.0",
    "@types/semver": "^7.5.8",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "babel-jest": "^30.2.0",
    "eslint": "^10.0.2",
    "jest-mock-extended": "^4.0.0-beta1",
    "ts-jest": "^29.2.5",
    "typedoc": "^0.27.6",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.56.1"
